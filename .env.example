# Copy this file to .env for a local development stack. Replace these values
# before any deployment beyond a workstation.
POSTGRES_DB=labscope
POSTGRES_USER=labscope
POSTGRES_PASSWORD=change-this-local-development-password
POSTGRES_PORT=5432
MQTT_PORT=1883
MOSQUITTO_ADMIN_USER=labscope-admin
MOSQUITTO_ADMIN_PASSWORD=change-this-local-development-admin-password
MOSQUITTO_INGEST_USER=labscope-ingest
MOSQUITTO_INGEST_PASSWORD=change-this-local-development-ingest-password
LABSCOPE_HTTP_PORT=8080
LABSCOPE_ENV=development
LABSCOPE_COOKIE_SECURE=0
LABSCOPE_INGEST_QUEUE_CAPACITY=8192
LABSCOPE_INGEST_WORKERS=4
LABSCOPE_INGEST_BATCH_SIZE=128
